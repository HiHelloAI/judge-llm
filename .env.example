# Judge LLM Environment Variables
# Copy this file to .env and fill in your API keys

# Google Gemini API Key
# Get your key from: https://ai.google.dev/
GOOGLE_API_KEY=your-google-api-key-here

# Custom defaults configuration path (optional)
# Override the default location for .judge_llm.defaults.yaml
# JUDGE_LLM_DEFAULTS=/path/to/your/defaults.yaml
